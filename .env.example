# Duck DNS subdomain without the .duckdns.org suffix.
DUCKDNS_SUBDOMAIN=lecrocodile
# Optional: needed only for rollback with compose.legacy.yaml.
# Use an absolute Linux path on Linux and forward slashes on Windows.
CERT_DIRECTORY=D:/Program files/LeCrocodile/Certificates
PFX_FILENAME=reviews-ethernet.pfx
# Leave empty for the existing passwordless legacy certificate.
PFX_PASSWORD=
